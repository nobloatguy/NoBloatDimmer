<Window x:Class="NoBloatDimmer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NoBloat Dimmer"
        Width="790"
        Height="650"
        MinWidth="680"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Foreground="#F5F7FA">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="30"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#11161D" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#171E27" />
        <SolidColorBrush x:Key="Border" Color="#29323E" />
        <SolidColorBrush x:Key="MutedText" Color="#8C98A7" />

        <SolidColorBrush x:Key="Accent" Color="#D2FF3E" />
        <SolidColorBrush x:Key="AccentSoft" Color="#263213" />
        <SolidColorBrush x:Key="AccentBorder" Color="#637E23" />

        <SolidColorBrush x:Key="DangerSurface" Color="#3B1C25" />
        <SolidColorBrush x:Key="DangerBorder" Color="#8A4051" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BaseButton"
               TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#1A222D" />
            <Setter Property="BorderBrush" Value="#344154" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#283343" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#53677E" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#111720" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}" />
                                <Setter TargetName="Root"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButton}" />

        <Style x:Key="SideButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="WindowButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#0D1218" />
            <Setter Property="BorderBrush" Value="#303B4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="ToolTip" Value="Left and right arrows adjust by 5%" />
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Margin="30"
            Background="#0E141B"
            BorderBrush="#2A3441"
            BorderThickness="1"
            CornerRadius="24"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="38"
                              ShadowDepth="12"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid x:Name="ShellContent"
              SizeChanged="ShellContent_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#121820"
                    BorderBrush="#26313E"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="20,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="25"
                                    Height="25"
                                    Background="{DynamicResource Accent}"
                                    CornerRadius="7">
                                <TextBlock Text="N"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#111700" />
                            </Border>

                            <TextBlock Text="NoBloat Dimmer"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#E6EBF2" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">
                        <Button Style="{StaticResource WindowButton}"
                                ToolTip="Minimize"
                                Click="Window_Minimize_Click">
                            <TextBlock Text="—"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="FullScreenButton"
                                Style="{StaticResource WindowButton}"
                                ToolTip="Full screen"
                                Click="Window_FullScreen_Click">
                            <TextBlock x:Name="FullScreenIcon"
                                       Text="□"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource WindowButton}"
                                ToolTip="Hide to tray"
                                Click="Window_Close_Click">
                            <TextBlock Text="×"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#10161E"
                        BorderBrush="#26313E"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,22,0,0">
                            <Button x:Name="DisplaysNavButton"
                                    Style="{StaticResource SideButton}"
                                    ToolTip="Displays"
                                    Click="DisplaysTab_Click">
                                <TextBlock Text="▣"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>

                            <Button x:Name="CustomizeNavButton"
                                    Style="{StaticResource SideButton}"
                                    ToolTip="Customize"
                                    Click="CustomizeTab_Click">
                                <TextBlock Text="⚙"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17" />
                            </Button>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Style="{StaticResource SideButton}"
                                ToolTip="Visit NoBloatTools.com"
                                ToolTipService.InitialShowDelay="250"
                                AutomationProperties.Name="Open NoBloatTools website"
                                Click="WebsiteButton_Click"
                                Margin="0,0,0,18"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="↗"
                                           HorizontalAlignment="Center"
                                           FontSize="18" />
                                <TextBlock Text="SITE"
                                           Margin="0,-3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                      Margin="34,30,34,26">

                    <Grid x:Name="DisplaysPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="DISPLAYS"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedText}" />

                                <TextBlock Text="Set the room."
                                           Margin="0,6,0,0"
                                           FontSize="31"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentSoft}"
                                    BorderBrush="{DynamicResource AccentBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="12,7"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{DynamicResource Accent}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />

                                    <TextBlock Text="On"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,26,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource AccentSoft}"
                                    BorderBrush="{DynamicResource AccentBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="ALL DISPLAYS"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#B7C795" />

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,8,0,0">
                                                <TextBlock x:Name="AllPercentText"
                                                           Text="0"
                                                           FontSize="46"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F2F7E6" />

                                                <TextBlock Text="%"
                                                           Margin="4,19,0,0"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#B7C795" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Width="64"
                                                Height="64"
                                                Background="#18220D"
                                                BorderBrush="{DynamicResource Accent}"
                                                BorderThickness="5"
                                                CornerRadius="32"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="☼"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="31"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </Grid>

                                    <Slider Grid.Row="1"
                                            x:Name="AllDisplaysSlider"
                                            Margin="0,14,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            ValueChanged="AllDisplaysSlider_ValueChanged" />

                                    <Grid Grid.Row="2"
                                          Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="Restore brightness"
                                                Click="TurnOff_Click" />

                                        <Button Grid.Column="2"
                                                x:Name="BlackoutButton"
                                                Content="Blackout"
                                                Background="{StaticResource DangerSurface}"
                                                BorderBrush="{StaticResource DangerBorder}"
                                                Click="Blackout_Click" />

                                        <Button Grid.Column="4"
                                                Content="Customize"
                                                Click="CustomizeTab_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Displays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    Padding="14,13"
                                                    Background="#121922"
                                                    BorderBrush="#27313F"
                                                    BorderThickness="1"
                                                    CornerRadius="13">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="31" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="22"
                                                                Height="15"
                                                                Margin="0,4,0,0"
                                                                BorderBrush="#788698"
                                                                BorderThickness="1"
                                                                CornerRadius="2" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold" />

                                                            <TextBlock Text="{Binding Detail}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource MutedText}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DimPercent, StringFormat={}{0}%}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#C5CFDB" />
                                                    </Grid>

                                                    <Slider Grid.Row="1"
                                                            Margin="31,9,0,0"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="{Binding DimPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="#202A37"
                                        BorderBrush="#344151"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,5">
                                    <TextBlock Text="Alt"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="+"
                                           Margin="5,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedText}" />

                                <Border Background="#202A37"
                                        BorderBrush="#344151"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,5">
                                    <TextBlock Text="Shift"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="+"
                                           Margin="5,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedText}" />

                                <Border Background="#202A37"
                                        BorderBrush="#344151"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,5">
                                    <TextBlock Text="↓"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="Dim display"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedText}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#171F29"
                                    BorderBrush="#354150"
                                    BorderThickness="1"
                                    CornerRadius="17"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{DynamicResource Accent}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />

                                    <TextBlock x:Name="StatusText"
                                               Text="Built local first"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#D6DEE7" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="CustomizePanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="PERSONALIZE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedText}" />

                            <TextBlock Text="Make it yours."
                                       Margin="0,6,0,0"
                                       FontSize="31"
                                       FontWeight="SemiBold" />

                            <TextBlock Margin="0,8,0,0"
                                       Text="Preferences are stored locally. No accounts or tracking."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedText}" />

                            <Border Margin="0,25,0,0"
                                    Background="#121922"
                                    BorderBrush="#27313F"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Accent color"
                                               FontSize="16"
                                               FontWeight="SemiBold" />

                                    <TextBlock Margin="0,4,0,0"
                                               Text="Lime matches the NoBloatTools site."
                                               FontSize="12"
                                               Foreground="{StaticResource MutedText}" />

                                    <UniformGrid Columns="4"
                                                 Margin="0,18,0,0">
                                        <Button x:Name="LimeThemeButton"
                                                Tag="Lime"
                                                Content="Lime"
                                                Click="ThemeButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="CyanThemeButton"
                                                Tag="Cyan"
                                                Content="Cyan"
                                                Click="ThemeButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="VioletThemeButton"
                                                Tag="Violet"
                                                Content="Violet"
                                                Click="ThemeButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="AmberThemeButton"
                                                Tag="Amber"
                                                Content="Amber"
                                                Click="ThemeButton_Click" />
                                    </UniformGrid>

                                    <TextBlock x:Name="ThemeStatusText"
                                               Margin="0,14,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Background="#121922"
                                    BorderBrush="#27313F"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Window size"
                                               FontSize="16"
                                               FontWeight="SemiBold" />

                                    <TextBlock Margin="0,4,0,0"
                                               Text="Three layouts that preserve the app’s visual balance."
                                               FontSize="12"
                                               Foreground="{StaticResource MutedText}" />

                                    <UniformGrid Columns="3"
                                                 Margin="0,18,0,0">
                                        <Button x:Name="CompactSizeButton"
                                                Tag="Compact"
                                                Content="Compact"
                                                Click="WindowSizeButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="StandardSizeButton"
                                                Tag="Standard"
                                                Content="Standard"
                                                Click="WindowSizeButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="SpaciousSizeButton"
                                                Tag="Spacious"
                                                Content="Spacious"
                                                Click="WindowSizeButton_Click" />
                                    </UniformGrid>

                                    <TextBlock x:Name="WindowSizeStatusText"
                                               Margin="0,14,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Background="#121922"
                                    BorderBrush="#27313F"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Quick reset key"
                                               FontSize="16"
                                               FontWeight="SemiBold" />

                                    <TextBlock Margin="0,4,0,0"
                                               Text="While this window is active, press the selected key to restore every display to 0%."
                                               FontSize="12"
                                               Foreground="{StaticResource MutedText}" />

                                    <UniformGrid Columns="3"
                                                 Margin="0,18,0,0">
                                        <Button x:Name="EnterResetKeyButton"
                                                Tag="Enter"
                                                Content="Enter"
                                                Click="ResetKeyButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="RResetKeyButton"
                                                Tag="R"
                                                Content="R"
                                                Click="ResetKeyButton_Click"
                                                Margin="0,0,8,0" />

                                        <Button x:Name="BackspaceResetKeyButton"
                                                Tag="Backspace"
                                                Content="Backspace"
                                                Click="ResetKeyButton_Click" />
                                    </UniformGrid>

                                    <TextBlock x:Name="ResetKeyStatusText"
                                               Margin="0,14,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Background="#121922"
                                    BorderBrush="#27313F"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Display names"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Margin="0,4,0,0"
                                                       Text="Rename your monitors here."
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedText}" />
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right"
                                                Content="Reset names"
                                                Click="ResetDisplayNames_Click" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Displays}"
                                                  Margin="0,18,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox MaxLength="32"
                                                             Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Grid.Column="1"
                                                               Margin="15,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding DimPercent, StringFormat={}{0}% dim}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,22,0,0"
                                       Cursor="Hand"
                                       FontSize="13"
                                       Foreground="{DynamicResource Accent}"
                                       MouseLeftButtonUp="WebsiteLink_Click">
